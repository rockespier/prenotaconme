<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PrenotaConMe.Infrastructure\PrenotaConMe.Infrastructure.csproj" />
    <ProjectReference Include="..\PrenotaConMe.Shared\PrenotaConMe.Shared.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Tenancy\PrenotaConMe.Modules.Tenancy.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Users\PrenotaConMe.Modules.Users.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Locations\PrenotaConMe.Modules.Locations.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Catalog\PrenotaConMe.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Staff\PrenotaConMe.Modules.Staff.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Scheduling\PrenotaConMe.Modules.Scheduling.csproj" />
    <ProjectReference Include="..\Modules\PrenotaConMe.Modules.Notifications\PrenotaConMe.Modules.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.4" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- OpenAPI document generated on build; consumed by the Angular client generator (npm run api:generate). -->
    <UserSecretsId>prenotaconme-api</UserSecretsId>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../frontend/prenotaconme-web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name prenotaconme-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

</Project>
