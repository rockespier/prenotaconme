<?xml version="1.0" encoding="utf-8"?>
<!-- F5-05: the publish step adds the aspNetCore handler; this only hides what IIS adds about itself. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
