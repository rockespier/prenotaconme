{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cors": {
    "Origins": []
  },
  "RateLimiting": {
    "PerMinute": 300,
    "SensitivePerHour": 30
  },
  "Security": {
    "EnforceCsp": false,
    "FirebaseAuthDomain": "prenotaconme-b1ddd.firebaseapp.com"
  },
  "Firebase": {
    "ProjectId": "prenotaconme-b1ddd"
  },
  "AllowedHosts": "*"
}
