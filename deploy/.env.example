# Copy to /opt/prenotaconme/.env on the VPS and fill in. Never commit the real file.
GHCR_OWNER=your-github-user
IMAGE_TAG=latest
SITE_DOMAIN=staging.example.com
ACME_EMAIL=you@example.com
ASPNETCORE_ENVIRONMENT=Staging
DATABASE_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=prenotaconme;Username=prenota;Password=CHANGE_ME
# Generate with: echo 'password' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=
